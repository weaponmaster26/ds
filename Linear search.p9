#include <stdio.h>
int main()
{
 int a[10], n, i, key;
 printf("Enter n: ");
 scanf("%d", &n);
 printf("Enter elements:\n");
 for(i = 0; i < n; i++)
 scanf("%d", &a[i]);
 printf("Enter key: ");
 scanf("%d", &key);
 for(i = 0; i < n; i++)
 {
 if(a[i] == key)
 {
 printf("Found at index %d\n", i);
 break;
 }
 }
 if(i == n)
 printf("Not found\n");
 return 0;
}
